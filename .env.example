# ==============================================================================
# TITANFIT BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và cập nhật thông tin môi trường của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.x)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 2. JWT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Khóa bí mật JWT tối thiểu 256-bit (Base64 hoặc chuỗi bảo mật cao)
JWT_SECRET=h5GJBuBwDmkM9+1XsTGOBJbMQUBygZZ41Zg8qdoHSpY=
# Thời hạn Access Token (mili-giây, mặc định 30 ngày = 2592000000 ms)
JWT_EXPIRATION=2592000000
ACCESS_TOKEN_EXP=1800
REFRESH_TOKEN_EXP=604800

# ------------------------------------------------------------------------------
# 3. INITIAL SEED ACCOUNTS (Tự động tạo khi khởi động nếu chưa tồn tại)
# ------------------------------------------------------------------------------
# Tài khoản Quản trị viên hệ thống (ROLE_ADMIN)
INIT_ADMIN_EMAIL=admin@titanfit.vn
INIT_ADMIN_PASSWORD=admin123

# Tài khoản Khách hàng mua sắm mẫu (ROLE_CUSTOMER)
INIT_BUYER_EMAIL=hoang.nguyen@example.com
INIT_BUYER_PASSWORD=123456
