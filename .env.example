# ==============================================================================
# TITANFIT BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và cập nhật thông tin môi trường của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. APPLICATION PROFILE & SEED CONFIGURATION
# ------------------------------------------------------------------------------
# Profile hoạt động: dev, prod, test (mặc định: dev)
SPRING_PROFILES_ACTIVE=dev
# Bật seed dữ liệu mẫu (Danh mục, Sản phẩm, Tài khoản mẫu). Mặc định tắt (false) trên production.
APP_SEED_ENABLED=true

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.x)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 2. JWT & COOKIE SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Khóa bí mật JWT tối thiểu 256-bit Base64 (sinh bằng lệnh: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# Thời hạn Access Token (giây, mặc định 1800 giây = 30 phút)
ACCESS_TOKEN_EXP=1800
# Thời hạn Refresh Token (giây, mặc định 604800 giây = 7 ngày)
REFRESH_TOKEN_EXP=604800
# Cờ bảo mật Cookie (true ở production có HTTPS, false ở dev HTTP)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Lưu trữ Refresh Token & Blacklist)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. INITIAL SEED ACCOUNTS (Khởi tạo Admin khi chạy lần đầu)
# ------------------------------------------------------------------------------
# Tài khoản Quản trị viên hệ thống (ROLE_ADMIN) - Ở production bắt buộc mật khẩu mạnh (>= 8 ký tự, không dùng mặc định)
INIT_ADMIN_EMAIL=admin@titanfit.vn
INIT_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_here
INIT_ADMIN_PHONE=0900000001

# ------------------------------------------------------------------------------
# 4. DEMO BUYER ACCOUNT (ROLE_CUSTOMER - Chỉ hoạt động ở profile dev)
# ------------------------------------------------------------------------------
INIT_BUYER_EMAIL=hoang.nguyen@example.com
INIT_BUYER_PASSWORD=123456
INIT_BUYER_PHONE=0912345678
